{
  "name": "ensemble",
  "version": "1.3.0",
  "private": true,
  "description": "Every account of one system, signed in at once. A local multi-account browser workbench for permission and collaboration testing.",
  "license": "MIT",
  "author": {
    "name": "OneFanki",
    "email": "onefanki@foxmail.com"
  },
  "homepage": "https://github.com/OneFanki/ensemble#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OneFanki/ensemble.git"
  },
  "bugs": {
    "url": "https://github.com/OneFanki/ensemble/issues"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "dist": "node scripts/make-icon.mjs && electron-vite build && electron-builder",
    "verify": "node scripts/verify.mjs",
    "icon": "node scripts/make-icon.mjs",
    "diagrams": "node scripts/make-diagrams.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "site": "node scripts/preview-site.mjs",
    "e2e:embedded": "node scripts/e2e-embedded.mjs",
    "e2e:browser-views": "node scripts/e2e-browser-views.mjs",
    "e2e:restore-surface": "node scripts/e2e-restore-surface.mjs",
    "e2e:v1-upgrade": "node scripts/e2e-v1-upgrade.mjs",
    "e2e:site-tags": "node scripts/e2e-site-tags.mjs",
    "e2e:tab-reorder": "node scripts/e2e-tab-reorder.mjs",
    "e2e:instances": "node scripts/e2e-instances.mjs",
    "e2e:empty-slot": "node scripts/e2e-empty-slot.mjs",
    "e2e:overlay-freeze": "node scripts/e2e-overlay-freeze.mjs",
    "e2e:placement": "node scripts/e2e-placement.mjs",
    "e2e:login-capture": "node scripts/e2e-login-capture.mjs",
    "e2e:mcp-tenant-setup": "node scripts/e2e-mcp-tenant-setup.mjs",
    "e2e:autofill": "node scripts/e2e-autofill.mjs",
    "e2e:ui-regressions": "node scripts/e2e-ui-regressions.mjs",
    "e2e:bookmarks": "node scripts/e2e-bookmarks.mjs",
    "e2e:ai-policy": "node scripts/e2e-ai-policy.mjs",
    "e2e:zoom-devtools": "node scripts/e2e-zoom-devtools.mjs",
    "e2e:dom-resolver": "node scripts/e2e-dom-resolver.mjs",
    "e2e:flows": "node scripts/e2e-flows.mjs",
    "e2e:batch-launch": "node scripts/e2e-batch-launch.mjs",
    "smoke:packaged": "node scripts/smoke-packaged-mcp.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vueuse/core": "15.0.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "lucide-vue-next": "1.0.0",
    "pinia": "4.1.0",
    "reka-ui": "2.11.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue": "3.5.44",
    "vue-i18n": "11.4.16",
    "vue-tsc": "3.3.13",
    "zod": "4.6.7"
  }
}
