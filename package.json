{
  "name": "ensemble",
  "version": "0.1.0",
  "private": true,
  "description": "Multiple identities, one stage. A local multi-account browser workbench for permission and collaboration testing.",
  "license": "MIT",
  "author": "OneFanki",
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "dist": "node scripts/make-icon.mjs && electron-vite build && electron-builder",
    "verify": "node scripts/verify.mjs",
    "icon": "node scripts/make-icon.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "@vueuse/core": "15.0.0",
    "lucide-vue-next": "1.0.0",
    "pinia": "4.1.0",
    "reka-ui": "2.11.0",
    "vue": "3.5.44",
    "vue-i18n": "11.4.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
